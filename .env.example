# Model (accept the Gemma license on Hugging Face before first use)
HF_TOKEN=
MODEL_ID=google/gemma-3-1b-it
MODEL_DEVICE=cpu
MODEL_DTYPE=float32
MODEL_QUANTIZATION=none
MAX_NEW_TOKENS=2048
MODEL_CONTEXT_MESSAGES=12
CPU_THREADS=0
DOCUMENT_MAX_CHARS=24000
SMART_CODE_MAX_CONTEXT_CHARS=48000
SMART_CODE_MAX_OUTPUT_TOKENS=4096
ESTIMATE_MAX_OUTPUT_TOKENS=3072
AGENT_RUN_RETENTION_DAYS=30

# YUKTI (Talk). The vault is your notes directory; empty disables the second brain
# entirely rather than guessing at a location.
YUKTI_ADDRESS=sir
YUKTI_VAULT_ROOT=

# Optional Talk mode (install the voice and visual extras first)
WHISPER_MODEL=base.en
WHISPER_COMPUTE_TYPE=int8
TTS_RATE=170
TTS_VOICE=female
MANIM_EXECUTABLE=manim
TEMPERATURE=0.2

# Server and storage
APP_HOST=127.0.0.1
APP_PORT=8765
APP_DATA_DIR=./data
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,null

# Optional Jira source for Estimate Code
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_STORY_POINTS_FIELD=customfield_10016
JIRA_WRITE_ENABLED=false

# Optional Phoenix (run `phoenix serve` locally)
PHOENIX_ENABLED=true
PHOENIX_COLLECTOR_ENDPOINT=http://127.0.0.1:6006/v1/traces

# Optional local image model (~1 GB first download). Install with `.[image]`.
IMAGE_MODEL_ID=segmind/tiny-sd
IMAGE_INFERENCE_STEPS=8
